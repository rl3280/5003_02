  {
    "@id": "https://dlnarratives.eu/ontology#Merge",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Merge node is a control node that brings together multiple incoming alternate flows to accept single outgoing flow. There is no joining of tokens. Merge should not be used to synchronize concurrent flows. In any execution, only one path will be taken at a time."
