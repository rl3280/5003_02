    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "This reification class was introduced to allow the assignment of a role to an actor. It represents the participation of the actor in the event.\n\nThis class has to be linked to:\n• an instance of the class E5 Event, through the property hadParticipant\n• an instance of the class E39 Actor, through the property hasSubject\n• an instance of the class Role, through the property hasRole"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ActorWithRole"
      }
    ]
  },
